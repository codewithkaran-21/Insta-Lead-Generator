# ─────────────────────────────────────────────────────────────────────────────
# InstaLeads — environment template
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# Reference: docs/configuration.md
# ─────────────────────────────────────────────────────────────────────────────

# ── Discovery ────────────────────────────────────────────────────────────────
# Apify API token (Stage 1 search + hashtag actors, Stage 3 profile scraper)
APIFY_API_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Serper.dev API key (Stage 1 Google dorking) — free 2,500-query pool
SERPER_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Classification ───────────────────────────────────────────────────────────
# Groq API key (Stage 5 Llama-3.1-8b-instant semantic classifier)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Persistence (Supabase) ───────────────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
# anon key: frontend read-only (governed by RLS). Safe to expose in the browser.
SUPABASE_ANON_KEY=eyJhbGciOiJI...xxxxxxxxxxxxxxxxxxxxxxxx
# service_role key: BACKEND ONLY (GitHub Actions). Full mutation. NEVER ship to frontend.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJI...xxxxxxxxxxxxxxxxxxxxxxxx

# ── Frontend (Next.js needs the NEXT_PUBLIC_ prefix) ─────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJI...xxxxxxxxxxxxxxxxxxxxxxxx

# ── Pipeline run parameters (SearchConfiguration) ────────────────────────────
TARGET_NICHE=fitness
TARGET_COUNTRY=USA
MIN_MEDIAN_ER=5.0
MIN_FOLLOWERS=10000
MAX_FOLLOWERS=100000

# ── Optional ─────────────────────────────────────────────────────────────────
# Slack incoming webhook for failure alerts (see docs/edge-cases.md)
SLACK_WEBHOOK_URL=
# structlog level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
